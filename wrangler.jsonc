{
  "name": "icachi",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "icachi.org", "custom_domain": true },
    { "pattern": "www.icachi.org", "custom_domain": true }
  ]
}
